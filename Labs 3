using System;
using System.Text;
using System.Globalization;

class FunctionTable
{
    const double Eps = 1e-9;

    static void Main()
    {
        Console.OutputEncoding = Encoding.UTF8;
        Console.InputEncoding = Encoding.UTF8;

        Console.WriteLine("=== ТАБЛИЦА ФУНКЦИИ y = x^2 ===");
        if (!TryReadDouble("Введите начало отрезка a: ", out double a) ||
            !TryReadDouble("Введите конец отрезка b: ", out double b) ||
            !TryReadDouble("Введите шаг h: ", out double h))
        {
            Console.WriteLine("Ошибка ввода: необходимо ввести числовые значения.");
            return;
        }

        // Проверка корректности границ отрезка и положительности шага
        if (h <= 0)
        {
            Console.WriteLine("Ошибка: шаг h должен быть строго больше нуля.");
            return;
        }
        if (a > b)
        {
            Console.WriteLine("Ошибка: начало отрезка a не может быть больше конца b.");
            return;
        }

        // Вывод заголовка таблицы значений
        Console.WriteLine($"\n{"x",10} | {"y = x^2",12}");
        Console.WriteLine(new string('-', 25));

        // Циклический расчёт значений функции на отрезке [a; b]
        int step = 0;
        while (true)
        {
            double x = a + step * h;
            if (x > b + Eps)
                break; // корректный выход из цикла при достижении границы b

            double y = x * x;
            Console.WriteLine($"{x,10:F2} | {y,12:F2}");
            step++;
        }

        Console.WriteLine($"\nВсего вычислено точек: {step}");
    }

    static bool TryReadDouble(string prompt, out double value)
    {
        Console.Write(prompt);
        string input = Console.ReadLine();
        return double.TryParse(input?.Replace(',', '.'), NumberStyles.Float,
                               CultureInfo.InvariantCulture, out value);
    }
}
 
